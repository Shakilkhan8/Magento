        <record model="ir.actions.server" id="action_send_product_images">
            <field name="name">Update Odoo2 Product Images</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="binding_model_id" ref="product.model_product_product"/>
            <field name="state">code</field>
            <field name="binding_view_types">list,form</field>
            <field name="code">
                action = records.update_odoo2_product_images()
            </field>
        </record>

        <record model="ir.actions.server" id="action_send_product_template_images">
            <field name="name">Update Odoo2 Product Template Images</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="binding_view_types">list,form</field>
            <field name="code">
                action = records.update_odoo2_product_images()
            </field>
        </record>


        <record id="action_sync_selected_products" model="ir.actions.server">
            <field name="name">Sync Selected Products</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="binding_model_id" ref="product.model_product_product"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                records.action_sync_products()
            </field>
        </record>

        <record id="action_update_product_variant_on_odoo2" model="ir.actions.server">
            <field name="name">Update Product In Bulk</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="binding_model_id" ref="product.model_product_product"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                records.action_update_odoo2_bulk()
            </field>
        </record>
        <!-- Inherit Form View to Modify it -->
        <record id="product_form_inherit_id" model="ir.ui.view">
            <field name="name">product.product</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='detailed_type']" position="after">
                    <field name="api_id"/>
                    <field name="sync_on"/>
                </xpath>

            </field>
        </record>

        <record id="product_template_form_inherit_id" model="ir.ui.view">
            <field name="name">product.template</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='detailed_type']" position="after">
                    <field name="api_id"/>
                    <field name="sync_on"/>
                    <button type="object" string="Update" name="update_variant_codes"/>
                    <field name="code" readonly="1"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
