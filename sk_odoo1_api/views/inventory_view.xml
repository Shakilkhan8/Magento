<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

         <record id="profit_margin_sequence" model="ir.sequence">
            <field name="name">Profit Margin Sequence</field>
            <field name="code">profit.margin.sequence</field>
            <field name="prefix">PM/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

       <record id="profit_margin_form" model="ir.ui.view">
           <field name="name">Profit Margin Form</field>
           <field name="model">profit.margin</field>
           <field name="arch" type="xml">
               <form string="_form">
                   <header>
                       <field name="state" widget="statusbar"  options="{'clickable': '1'}"/>
                   </header>
                   <sheet>
                        <div class="oe_title">
                               <h1>
                                   <field name="name" readonly="1"/>
                               </h1>
                           </div>
                       <group>
                           <group>
                               <field name="description"/>
                           </group>
                           <group>
                               <field name="date"/>
                           </group>

                           <notebook>
                               <page string="Category Profit Lines">
                                   <field name="line_ids">
                                       <tree editable="bottom">
                                           <field name="category_id"/>
                                           <field name="percentage"/>
                                       </tree>
                                   </field>
                               </page>
                           </notebook>
                       </group>
                   </sheet>
               </form>
           </field>
       </record>


        <record id="profit_margin_tree" model="ir.ui.view">
            <field name="name">Profit Margin Tree</field>
            <field name="model">profit.margin</field>
            <field name="arch" type="xml">
                <tree string="_tree">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="date"/>
                </tree>
            </field>
        </record>

        <record id="profit_margin_action" model="ir.actions.act_window">
            <field name="name">Profit Margin</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">profit.margin</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="profit_margin_menu" name="Profit Margin" parent="stock.menu_stock_config_settings" action="profit_margin_action"/>

        <!-- Inherit Form View to Modify it -->
        <record id="stock_picking_form_inherit" model="ir.ui.view">
            <field name="name">Stock Picking</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='origin']" position="after">
                    <field name="is_backorder" readonly="1"/>
                </xpath>

                <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_uom_qty']" position="after">
                    <field name="extra_delivery_qty"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>