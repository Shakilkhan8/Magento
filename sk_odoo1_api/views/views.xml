<odoo>
  <data>
    <record id="view_order_form_inherit_extra_qty" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.extra.qty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="api_order_id"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']" position="after">
                <field name="extra_delivery_qty" decoration-info="extra_delivery_qty > 0"/>
            </xpath>
        </field>
    </record>

  </data>
</odoo>
