<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

       <record id="action_api_config_form" model="ir.ui.view">
           <field name="name">API Config Form</field>
           <field name="model">api.configuration</field>
           <field name="arch" type="xml">
               <form string="_form">
                   <sheet>
                       <div class="oe_title">
                           <h1>
                               <field name="name"/>
                           </h1>
                       </div>
                       <group>
                           <group>
                               <field name="url"/>
                               <field name="db_name"/>
                               <field name="user_name"/>
                               <field name="password"/>
                           </group>
                       </group>
                   </sheet>
               </form>
           </field>
       </record>


        <record id="api_config_action" model="ir.actions.act_window">
            <field name="name">API Configuration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">api.configuration</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="api_configuration_menu" web_icon="sk_odo21_api,static/description/api_png.png" name="API Configuration" action="api_config_action" sequence="1"/>
    </data>
</odoo>